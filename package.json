{
  "name": "flick",
  "description": "A keyboard command palette for Chrome: search tabs and bookmarks, jump to sites with shortcuts, paste snippets and run page tools.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anikets08/flick.git"
  },
  "keywords": [
    "chrome-extension",
    "command-palette",
    "flick",
    "spotlight",
    "productivity",
    "aliases",
    "shortcuts",
    "developer-tools"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && FLICK_E2E=1 wxt build && playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-preact": "^0.525.0",
    "lucide-react": "^0.525.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  }
}
